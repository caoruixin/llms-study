# 复制为 .env.local 并填入你的 key（.env.local 不进 git、不进前端 bundle，由 vite dev proxy 注入上游 Authorization）
# 也可以不配置，直接在应用「设置」页粘贴 key（只存内存/sessionStorage）
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
# 通用 OpenAI 兼容端点（可指向任意兼容服务，dev server 启动时固定）
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Kimi / Moonshot：KIMI_API_KEY 优先，MOONSHOT_API_KEY 为一版兼容别名（后续移除）
KIMI_API_KEY=
# 各 *_BASE_URL 只写协议+域名（不要带 /v1），dev server 启动时固定
KIMI_BASE_URL=
DEEPSEEK_BASE_URL=
# Jina（Paper Copilot 语义检索/重排增强，默认关闭，需用户单独授权）
JINA_API_KEY=
JINA_BASE_URL=
# 论文陪读功能开关（VITE_ 前缀 = build-time 内联进 bundle）。
# 建议写在 .env.development.local：npm run dev 打开，npm run build（production）自动关闭。
VITE_ENABLE_PAPER_COPILOT=
