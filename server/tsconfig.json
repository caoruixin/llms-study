{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // rootDir 指仓库根:server 通过相对路径引用 ../shared(不搞 alias),
    // 因此编译输入横跨 server/ 与 shared/ 两棵树
    "rootDir": "..",
    "types": ["node"]
  },
  // ../src/lib/keyRotation.ts:前端与网关共用的纯逻辑(零依赖),直接编进来避免复制漂移
  // ../src/lib/paper/url/captureAgent.ts:捕获代理(零 import、不碰 DOM lib 类型),渲染服务把它
  // toString() 后注进无头浏览器的真实页面里跑(src/render/browser.ts)——与客户端 Tier 2 用同一份代码
  "include": [
    "src",
    "test",
    "../shared",
    "../src/lib/keyRotation.ts",
    "../src/lib/paper/url/captureAgent.ts"
  ]
}
