# 复制为 server/.env 供本地开发(server/.env 不进 git);
# 生产不用 .env 文件,env 来自 systemd EnvironmentFile=/etc/llms-study/api.env(0600)。
# 已有环境变量优先于 .env 文件(process.loadEnvFile 语义)。

# 监听端口/地址。默认 8787 / 127.0.0.1(公网入口只有 nginx,后端永不直接暴露)
PORT=8787
#HOST=127.0.0.1

# 数据根目录:SQLite 与用户文件都在这下面。默认 = 起服 cwd 下的 data/(dev 从 server/ 起服 → server/data)
# 生产设为 /var/lib/llms-study
#DATA_DIR=
# 细分覆盖(一般不用,默认 $DATA_DIR/data.db 与 $DATA_DIR/files)
#DB_PATH=
#FILES_DIR=

# 用户 LLM key 落库加密的主密钥:64 位 hex(32 字节),必填。生成:openssl rand -hex 32
# 泄露即可解密全部用户 key——生产只放 0600 的 api.env,勿入 git/日志
LLM_KEY_MASTER=

# admin 种子:仅 users 表为空时创建(改 env 重启不会重置已有 admin);首登后请立即改密
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# 非 GET 请求的 Origin allowlist(逗号分隔,CSRF 防线)。默认 https://llm-pro.cn
# dev 必须包含 vite 端口,否则浏览器写请求全 403
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

# session cookie 是否带 Secure。默认 true;dev 走 http 必须显式 false,否则浏览器拒收 cookie
COOKIE_SECURE=false

# 服务端各 provider key 列表(逗号分隔,依序故障转移;P2 LLM 网关注入 admin 请求用)
SERVER_DEEPSEEK_KEYS=
SERVER_MOONSHOT_KEYS=
SERVER_ZHIPU_KEYS=
SERVER_JINA_KEYS=
SERVER_OPENAI_COMPAT_KEYS=

# admin 走服务端 key 的日调用上限(账单兜底);0/缺省 = 不限
#ADMIN_DAILY_CALL_LIMIT=0

# LLM 上游 base URL 覆盖(一般不用;env 名与 vite.config.ts dev 代理一致)
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#KIMI_BASE_URL=https://api.moonshot.cn
#ZHIPU_BASE_URL=https://open.bigmodel.cn
#JINA_BASE_URL=https://api.jina.ai
#OPENAI_COMPAT_BASE_URL=https://api.openai.com

# 【仅本机开发】fake-IP 代理环境(系统 DNS 把公网域名解析进 198.18/15)下放行 fetch-url。
# 生产严禁配置——等于拆掉 SSRF 防线。
# FETCH_URL_ALLOW_FORBIDDEN_DEV=1

# ---- 服务端渲染兜底(网页原貌导入 Tier 3:纯客户端渲染的页面)----

# 功能开关 = 渲染服务的 unix socket 绝对路径;缺省/留空 = 整体关闭
# (POST /api/app/render-url 回 503 render-unavailable,前端回落到如实报错)。
# 渲染服务是**另一个进程**(src/render/index.ts;生产是独立的 systemd unit + 独立用户,
# 见 deploy/llms-study-render.service 与 deploy/provision.md 第 10 节),这里只告诉 API 去哪儿找它。
# 生产值:/run/llms-study-render/render.sock;删掉这一行 + 重启 API = 即时关闭。
#RENDER_SERVICE_SOCKET=

# ↓↓↓ 以下三个变量**不是给 API 读的**,是渲染服务进程自己的 env。
# 渲染服务刻意**不加载本文件**(这里有 LLM_KEY_MASTER 与上游 key,读进去就会被 Chromium 子进程继承):
# 生产写在 /etc/llms-study/render.env(无机密),本地开发在命令行上内联传,例如
#   RENDER_SOCKET_PATH="$TMPDIR/render.sock" \
#   RENDER_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#   RENDER_ALLOW_FORBIDDEN_DEV=1 \
#   ./node_modules/.bin/tsx src/render/index.ts
# 然后给 API 配 RENDER_SERVICE_SOCKET=<同一个路径>。
# (macOS 的 unix socket 路径上限 104 字节,别放进太深的目录)
#
# RENDER_SOCKET_PATH   必填,绝对路径。只听这个 socket(0660),不开任何 TCP 端口
# RENDER_CHROME_PATH   必填,Chrome 可执行文件的绝对路径(不让 playwright 自己找/自己下)。
#                      生产(Google Chrome RPM):/opt/google/chrome/chrome
# RENDER_ALLOW_FORBIDDEN_DEV=1
#                      【仅本机开发】fake-IP 代理环境下放行"解析到 198.18/15"的域名,否则什么都渲染不出来。
#                      比 FETCH_URL_ALLOW_FORBIDDEN_DEV 收得更紧:localhost、解析到内网的域名、字面 IP 仍然被拒。
#                      生产严禁配置——渲染服务在 systemd 下检测到它会直接拒绝启动。

# ---- 语音助手(Voice Copilot:论文陪读的语音提问 + 云端朗读)----

# 语音 provider:none(默认,整体关闭,前端不渲染麦克风球)| siliconflow
# 设为 siliconflow 而 SERVER_SILICONFLOW_KEYS 为空 → 启动直接失败(不允许"以为开了其实没开")
VOICE_PROVIDER=none

# SiliconFlow key 列表(逗号分隔,依序故障转移;语义同 SERVER_*_KEYS)。
# 与 LLM 网关的 provider 无关——语音刻意不进 LLM_PROVIDERS,不走 /api/{provider} 那套
SERVER_SILICONFLOW_KEYS=

# 语音上游 base URL。默认 https://api.siliconflow.cn
# 末尾的 / 与 /v1 会被自动剥掉(路径常量自带 /v1),写成哪种都不会拼错
#SILICONFLOW_BASE_URL=https://api.siliconflow.cn

# 模型/默认音色覆盖(一般不用;换模型不必改代码)
#VOICE_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
#VOICE_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# 音色 id:alex/anna/bella/benjamin/charles/claire/david/diana
#VOICE_TTS_VOICE=anna

# 每用户每日 TTS 字符上限(账单兜底,按 voice_call_log 当日 SUM(chars_in) 统计);0/缺省 = 不限
#VOICE_DAILY_CHAR_LIMIT=0
