# 复制为 server/.env 供本地开发(server/.env 不进 git);
# 生产不用 .env 文件,env 来自 systemd EnvironmentFile=/etc/llms-study/api.env(0600)。
# 已有环境变量优先于 .env 文件(process.loadEnvFile 语义)。

# 监听端口/地址。默认 8787 / 127.0.0.1(公网入口只有 nginx,后端永不直接暴露)
PORT=8787
#HOST=127.0.0.1

# 数据根目录:SQLite 与用户文件都在这下面。默认 = 起服 cwd 下的 data/(dev 从 server/ 起服 → server/data)
# 生产设为 /var/lib/llms-study
#DATA_DIR=
# 细分覆盖(一般不用,默认 $DATA_DIR/data.db 与 $DATA_DIR/files)
#DB_PATH=
#FILES_DIR=

# 用户 LLM key 落库加密的主密钥:64 位 hex(32 字节),必填。生成:openssl rand -hex 32
# 泄露即可解密全部用户 key——生产只放 0600 的 api.env,勿入 git/日志
LLM_KEY_MASTER=

# admin 种子:仅 users 表为空时创建(改 env 重启不会重置已有 admin);首登后请立即改密
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# 非 GET 请求的 Origin allowlist(逗号分隔,CSRF 防线)。默认 https://llm-pro.cn
# dev 必须包含 vite 端口,否则浏览器写请求全 403
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

# session cookie 是否带 Secure。默认 true;dev 走 http 必须显式 false,否则浏览器拒收 cookie
COOKIE_SECURE=false

# 服务端各 provider key 列表(逗号分隔,依序故障转移;P2 LLM 网关注入 admin 请求用)
SERVER_DEEPSEEK_KEYS=
SERVER_MOONSHOT_KEYS=
SERVER_ZHIPU_KEYS=
SERVER_JINA_KEYS=
SERVER_OPENAI_COMPAT_KEYS=

# admin 走服务端 key 的日调用上限(账单兜底);0/缺省 = 不限
#ADMIN_DAILY_CALL_LIMIT=0

# LLM 上游 base URL 覆盖(一般不用;env 名与 vite.config.ts dev 代理一致)
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#KIMI_BASE_URL=https://api.moonshot.cn
#ZHIPU_BASE_URL=https://open.bigmodel.cn
#JINA_BASE_URL=https://api.jina.ai
#OPENAI_COMPAT_BASE_URL=https://api.openai.com

# 【仅本机开发】fake-IP 代理环境(系统 DNS 把公网域名解析进 198.18/15)下放行 fetch-url。
# 生产严禁配置——等于拆掉 SSRF 防线。
# FETCH_URL_ALLOW_FORBIDDEN_DEV=1
